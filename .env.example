# ==========================================
# Frontend & Supabase Environment Variables
# ==========================================

# Supabase Project URL (Required)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Publishable / Anon Key (Safe for browser)
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"

# Supabase Service Role Secret Key (Server-Only, NEVER expose to browser)
# Used in TanStack Start createServerFn handlers for private bucket operations
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxx"

# Storage Bucket Configuration (Defaults to 'books')
SUPABASE_BUCKET="books"

# Owner User UID (Used for the owner account's library prefix)
SUPABASE_OWNER_UID="xxxxx"
